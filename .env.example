# Copy to .env and fill in. Never commit .env.
# Points tau2 at the pinned data directory (scripts/setup_tau2.* fetches it).
TAU2_DATA_DIR=third_party/tau2-bench/data

# LLM provider keys used through litellm (synthesis roles, user simulator, solver).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LITELLM_API_KEY=
# LITELLM_API_BASE=  # Set the gateway URL in your invoking environment; never commit it.
